# Choose provider: "openai" (default) or "google"
AI_PROVIDER=openai

# Required if AI_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Required if AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=...

# Optional: override the Gemini model IDs without touching code.
# Google retires Gemini aliases every few months (the whole 1.5 family and
# gemini-2.0-flash are gone from v1beta as of mid-2026). If you start seeing
# "models/... is not found for API version v1beta", check
# https://ai.google.dev/gemini-api/docs/models for the current valid ID and
# set it here instead of editing route.ts.
# GEMINI_FAST_MODEL_ID=gemini-3.5-flash
# GEMINI_ADVANCED_MODEL_ID=gemini-3.5-flash
