{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes",
  "version": "1.0.0",
  "identifier": "com.ai-notion-editor.hermes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npx cross-env NEXT_OUTPUT=standalone npm run build && node scripts/copy-standalone-to-tauri.mjs",
    "frontendDist": "http://localhost:3000"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/standalone": "standalone"
    }
  }
}
